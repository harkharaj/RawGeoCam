<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1A1A"
        android:fontFamily="monospace"
        android:lineSpacingExtra="2dp"
        android:padding="8dp"
        android:text="Starting…"
        android:textColor="#F2F2F2"
        android:textSize="11sp" />

    <FrameLayout
        android:id="@+id/previewContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextureView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- Manual mode controls; values are saved per lens and restored on the next launch. -->
    <LinearLayout
        android:id="@+id/manualPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1A1A"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/lblShutter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="Shutter"
            android:textColor="#F2F2F2"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/seekShutter"
            android:layout_width="match_parent"
            android:layout_height="32dp" />

        <TextView
            android:id="@+id/lblIso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="ISO"
            android:textColor="#F2F2F2"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/seekIso"
            android:layout_width="match_parent"
            android:layout_height="32dp" />

        <TextView
            android:id="@+id/lblFocus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="Focus"
            android:textColor="#F2F2F2"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/seekFocus"
            android:layout_width="match_parent"
            android:layout_height="32dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1A1A"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="10dp"
        android:paddingEnd="8dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/btnLens"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Lens"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnMode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="Auto"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnShutter"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1.4"
            android:text="Capture"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnFocus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Focus ∞"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
